extends RefCounted

const ARRIVAL := [
 ["control","Control de Misión a Killa Wasi: alunizaje confirmado. Durante 30 días comprobarán cómo vivir y trabajar en esta base lunar."],
 ["control","Cuiden a la tripulación, mantengan los sistemas y recojan información para futuras expediciones. Su regreso está previsto al terminar la misión."],
 ["commander","Recibido. Mi primer paso será entrar y reunir al equipo."],
 ["robot","¡Robot guía conectado! Si quieres una pista, pulsa R o mi botón: tú decides cuándo pedir ayuda."]
]
const MEETING := [
 ["commander","¡Bienvenidos a Killa Wasi! Somos cinco personas con habilidades distintas y una misma misión: cuidarnos mientras aprendemos."],
 ["engineer","Soy el ingeniero jefe: cuido aire, agua y energía. Si una máquina estornuda, yo busco el filtro… ¡las máquinas no usan pañuelos!"],
 ["botanist","Soy la bióloga botánica. Investigaré cómo crecen nuestras plantas; por ahora, la despensa trae la mayor parte de nuestra comida."],
 ["doctor","Soy el médico de vuelo. Me encargo de la salud, el ejercicio y el descanso: dormir también cuenta como trabajo de astronauta."],
 ["geologist","Soy el geólogo lunar. Las rocas son mis libros favoritos: juntos aprenderemos a leer sus pistas."],
 ["commander","Yo coordinaré las prioridades y escucharé sus informes. Si algo sale distinto de lo esperado, lo revisaremos juntos."],
 ["robot","Yo puedo explicar palabras difíciles y ayudarte a comparar opciones. Mi botón siempre está disponible, pero la decisión es tuya."],
 ["doctor","Empecemos con una revisión después del viaje. Te espero en la bahía médica; el mapa con M muestra cómo llegar."]
]

# Story data contains intent and answers. Only Mission applies results.
static func task(id: String, day: int, room: String, target: String, title: String, speaker: String, intro: String, question: String, choices: Array, correct: int, success: String, concept: String) -> Dictionary:
 return {"id":id,"day":day,"room":room,"target":target,"title":title,"speaker":speaker,"intro":intro,"question":question,"choices":choices,"correct":correct,"success":success,"concept":concept}

static func tasks() -> Array:
 return [
 task("meeting",1,"shelter","shield","Reúne al equipo en la sala común","commander","Todo el equipo está listo para conocerte.","¿Comenzamos nuestra reunión?",["Escuchar al equipo"],0,"¡Ahora conocemos nuestras responsabilidades!","Coordinar significa escuchar a personas con habilidades diferentes."),
 task("checkup",1,"medical","bed_med","Habla con el médico sobre el viaje","doctor","Después del viaje, algunas personas necesitan tiempo para adaptarse. Quiero saber cómo te sientes, no que adivines un diagnóstico.","¿Qué ayuda más en la revisión?",["Contar cómo me siento y dejarme revisar","Ocultar un mareo para salir rápido","Elegir una medicina por mi cuenta"],0,"Gracias por contarlo. Haremos pausas y seguiremos el plan del equipo médico.","Al cambiar de gravedad, nuestro equilibrio puede necesitar adaptación. El médico decide la atención."),
 task("vitals",1,"medical","vitals","Comprueba las señales del cuerpo","doctor","Mira estos sensores: son pistas, no una bola de cristal. El pulso puede cambiar cuando hacemos ejercicio o nos ponemos nerviosos.","¿Cómo usamos una lectura inesperada?",["Diagnosticar solo con un número","Repetir la medición y consultarla conmigo","Ignorar todas las pantallas"],1,"¡Eso es investigar! Comparamos la lectura y lo que siente la persona antes de decidir.","Un instrumento puede fallar o dar una lectura incompleta. Comprobar evita conclusiones apresuradas."),
 task("meal",1,"shelter","food","Organiza la primera comida","botanist","Tenemos comidas variadas y especias opcionales. Algunas personas notaron cambios de olfato durante el viaje: preguntaremos qué les apetece.","Elige un menú completo para el equipo.",["Menú suave; condimentos por separado","Menú sazonado; alternativa suave disponible"],-1,"Anotamos las preferencias y las raciones utilizadas. ¡Comer juntos también ayuda a sentirnos en casa!","Los gustos son distintos. No todo astronauta necesita picante y la comida debe aportar nutrientes."),
 task("priority",1,"command","command","Elige la primera preparación","commander","Tenemos un bloque de preparación antes de revisar el descanso. Podemos localizar repuestos o comprobar el laboratorio; ambas opciones son útiles.","¿Qué prioridad eliges?",["Almacén: localizar un filtro de aire","Laboratorio: calibrar el analizador"],-1,"Prioridad confirmada. El mapa señala dónde empezar y la otra preparación seguirá disponible.","Elegir una prioridad no vuelve inútil a la otra: cambia qué beneficio obtenemos primero."),
 task("prepare",1,"engineering","spares","Completa tu preparación elegida","engineer","Las etiquetas son nuestro mapa del tesoro. Una pieza sin registrar puede parecer perdida aunque esté delante de nosotros.","¿Qué comprobamos antes de usar un repuesto?",["Solo su color","Su etiqueta y el equipo compatible","Que sea el más grande"],1,"¡Preparación completada! El informe conservará este beneficio.","Los repuestos deben ser compatibles; los instrumentos se comprueban con referencias conocidas."),
 task("bedtime",1,"bedroom","sleep","Prepara el dormitorio","doctor","Cinco camas, una por persona. Antes de dormir revisamos luz, ruido y circulación de aire.","¿Qué rutina favorece el descanso?",["Luces intensas toda la noche","Turnos sin pausas","Luz suave, ventilación y horario de descanso"],2,"Todo casi listo… Espera: el sensor acaba de detectar un problema de ventilación.","Un descanso adecuado ayuda a la atención y al ánimo. La base necesita aire circulando incluso de noche."),
 task("air_read",1,"bedroom","vent","Consulta el aviso de ventilación","engineer","El sensor indica poco flujo y CO₂ en aumento. ¡Vamos por pasos, comandante: primero comprender, después reparar!","¿Qué puede ocurrir con poco flujo?",["Acumulación de CO₂ en una zona","Desaparición de la gravedad","Que el CO₂ se vuelva visible"],0,"Correcto. El CO₂ es invisible; los colores del sensor nos ayudan a interpretar la lectura.","Exhalamos CO₂. En una base cerrada necesitamos ventilación y un sistema que lo retire."),
 task("air_clear",1,"bedroom","vent","Despeja la rejilla del dormitorio","engineer","Encontré una cubierta que bloquea la entrada de aire. Tenemos que retirarla y comprobar el filtro.","Selecciona una acción de mantenimiento.",["Tapar más la rejilla","Retirar la cubierta con el equipo en modo seguro","Subir el volumen de la alarma"],1,"La entrada quedó libre. Ahora comprobaremos si el ventilador y el circuito vuelven a funcionar.","Un ventilador necesita un paso libre para mover aire. Más potencia no arregla una abertura tapada."),
 task("air_on",1,"bedroom","vent","Activa la circulación y comprueba","engineer","La rejilla ya está libre. Una reparación no termina hasta comprobar el resultado.","¿Qué lectura confirma que mejoramos?",["Flujo recuperado y CO₂ bajando","Solo una luz encendida","Una pantalla sin números"],0,"El flujo se recupera y la lectura mejora. ¡Dormitorio listo y alarma resuelta!","Medir antes y después permite saber si una reparación funcionó."),
 task("day1_report",1,"command","command","Envía el informe del día 1","commander","Hoy aprendimos a escuchar al equipo, elegir prioridades y comprobar una reparación.","¿Qué debe incluir el informe?",["Problema, acción y resultado","Solo las cosas que salieron perfectas","Nada sobre la avería"],0,"Informe enviado. Una noche de descanso después… comienza nuestro segundo día.","Compartir los errores y los resultados ayuda a que todo el equipo aprenda."),
 task("suit_check",2,"airlock","suits","Revisa el traje para la primera salida","engineer","Revisaremos casco, guantes, conexiones y reservas. El geólogo nos acompañará; el rover espera como equipo de apoyo.","¿Qué hacemos con un sello sucio?",["Lo tapamos con una pegatina","Lo revisamos y limpiamos antes de salir","Esperamos a que el polvo desaparezca"],1,"Sellos y conexiones comprobados. Ahora confirmaremos cómo mantener el contacto.","Un traje conserva un ambiente respirable alrededor del cuerpo. Sus uniones deben estar en buen estado."),
 task("radio_check",2,"command","radio","Comprueba las comunicaciones","geologist","Yo llevaré el registro de muestras. Tú coordina el recorrido; comprobemos el enlace antes de separarnos de la base.","¿Cómo verificamos la radio?",["Mandando un mensaje y esperando respuesta","Mirando solo la antena","Apagándola para ahorrar"],0,"Te escucho fuerte y claro. Dejamos registrada la ruta y el punto de regreso.","Una prueba de ida y vuelta confirma mejor el enlace que mirar una luz."),
 task("prebreathe",2,"airlock","lock","Completa la preparación de la esclusa","doctor","La presión del traje puede ser distinta de la de la base. Seguimos un protocolo de respiración y comprobaciones para reducir el riesgo al cambiar de presión.","¿Qué opción prepara una salida segura?",["Abrir ambas puertas","Seguir el protocolo indicado y comprobar la presión","Elegir un tiempo al azar"],1,"Protocolo completado mediante un salto de tiempo. La puerta exterior ya está habilitada.","Respirar oxígeno según el protocolo ayuda a reducir el nitrógeno del cuerpo. No elimina todos los riesgos."),
 task("rover_notice",2,"exterior","rover","Inspecciona el rover de apoyo","geologist","Hay un borde roto en el guardabarros. Si movemos el rover así, sus ruedas lanzarán polvo sobre el equipo.","¿Qué hacemos antes de continuar?",["Acelerar para dejar el polvo atrás","Parar e inspeccionar el guardabarros","Limpiar solo la pantalla"],1,"¡Aviso de mantenimiento! Prepararemos un parche temporal sin mover el vehículo.","El polvo puede tapar y desgastar mecanismos. Un guardabarros evita parte de la dispersión."),
 task("rover_patch",2,"exterior","rover","Elige y coloca el parche temporal","engineer","Desde la base te guío. En Apollo 17 se improvisó un guardabarros con mapas y sujeciones; tenemos material preparado para practicar esa idea.","¿Qué combinación sirve mejor?",["Una lámina flexible y abrazaderas","Una bolsa abierta sin sujeción","Una pieza que toque la rueda"],0,"Parche colocado. Falta comprobar que esté firme y deje girar la rueda.","Una reparación temporal debe cubrir el daño y sujetarse sin crear otro problema."),
 task("rover_test",2,"exterior","rover","Comprueba el guardabarros reparado","geologist","Vamos a revisar tres cosas: cobertura, sujeción y espacio para la rueda.","¿Qué resultado permite continuar?",["Está bonito, aunque roza","Cubre el hueco, está firme y no roza","Sigue soltándose, pero ya tenemos prisa"],1,"Comprobación superada. El rover queda estacionado mientras documentamos una muestra.","Comprobar una reparación es parte de repararla. La apariencia no basta."),
 task("sample2",2,"exterior","rock","Documenta la muestra del día 2","geologist","¡Una roca llena de preguntas! Antes de recogerla, registremos el lugar y cómo la encontramos.","¿Qué etiqueta conserva mejor sus pistas?",["Roca bonita","Muestra A: lugar, fecha y observaciones","Piedra cualquiera"],1,"Registro guardado. Puedes recoger una muestra extra si la salida sigue autorizada, o regresar a la esclusa.","El contexto de una muestra es tan importante como la muestra misma."),
 task("dust_return",2,"airlock","dust","Retira el polvo antes de entrar","engineer","El polvo se pega a botas, herramientas y juntas. La estación de limpieza trabaja dentro de una zona controlada para no repartirlo por el hábitat.","¿Qué secuencia evita llevarlo a la base?",["Limpiar y contener el polvo antes de cruzar","Sacudir el traje en el dormitorio","Entrar y limpiar mañana"],0,"El equipo pasó por la estación de limpieza. Ahora toca inspeccionar las uniones del traje.","El polvo lunar es abrasivo. La limpieza controlada protege al equipo y a la tripulación."),
 task("seals",2,"airlock","suits","Inspecciona las uniones del traje","engineer","Buscamos restos de polvo y señales de desgaste. Si algo no está bien, lo registramos y lo revisa el especialista.","¿Qué hacemos al encontrar una unión dañada?",["Forzarla hasta que cierre","Registrar el daño y retirar el traje de servicio","Ocultarla bajo cinta"],1,"Inspección terminada y registrada. Guardamos los trajes preparados para su siguiente revisión.","La inspección detecta problemas antes de que se conviertan en una emergencia."),
 task("sample_lab",2,"minerals","analyzer","Compara la muestra en el laboratorio","geologist","El analizador compara nuestra muestra con una referencia. Si no lo calibramos ayer, completaré esa preparación contigo ahora.","¿Qué significa calibrar?",["Pintar el instrumento","Compararlo con una referencia conocida","Elegir el resultado que más nos gusta"],1,"Instrumento comprobado y registro científico guardado. ¡Una buena etiqueta ha viajado de la Luna al laboratorio!","Una medición útil necesita instrumentos comprobados y muestras bien documentadas."),
 task("day2_report",2,"command","command","Envía el informe del día 2","commander","Preparación, trabajo en equipo, reparación y limpieza: cada paso ayudó a que volviéramos bien.","¿Qué aprendizaje compartimos?",["Revisar antes y después de una salida","Solo correr más rápido","Que el polvo no importa"],0,"Informe enviado. Tras el descanso comienza el tercer día.","Las listas de comprobación ayudan a no olvidar pasos importantes."),
 task("water_read",3,"engineering","water","Investiga la caída del agua recuperada","engineer","Estamos recuperando menos agua de la prevista. Revisemos lecturas y reservas antes de cambiar piezas.","¿Qué datos conviene comparar?",["Agua que entra, agua recuperada y calidad","El color de la habitación","Solo el tamaño del tanque"],0,"Los datos señalan un cartucho saturado. Podemos repararlo manteniendo una reserva segura.","Reciclar agua requiere varios tratamientos y controles. Una caída del rendimiento necesita diagnóstico."),
 task("water_choice",3,"engineering","water","Decide cómo repartir el agua","botanist","Podemos usar una reserva para mantener todos los servicios, o pausar brevemente el riego mientras reparamos. Las plantas toleran esta pausa corta prevista por el equipo.","¿Qué prioridad eliges durante la reparación?",["Usar 1 reserva de agua","Pausar el riego y conservar la reserva"],-1,"Decisión anotada. Revisaremos después el efecto en reservas o en el riego.","Ambas opciones tienen un beneficio y un coste. Las necesidades esenciales de las personas quedan cubiertas."),
 task("water_filter",3,"engineering","filter","Selecciona el cartucho correcto","engineer","Tenemos dos piezas con nombres parecidos. El filtro de aire no sustituye al cartucho del procesador de agua.","¿Qué repuesto instalamos?",["Filtro de aire","Cartucho de agua compatible","Cualquier pieza que quepa"],1,"Cartucho de agua instalado con el circuito en modo de mantenimiento. ¡Vamos a comprobar el resultado!","Cada circuito necesita un repuesto compatible, identificado por su etiqueta."),
 task("water_test",3,"engineering","water","Verifica la calidad del agua","engineer","El flujo ha mejorado, pero todavía falta verificar la calidad. Un agua transparente no siempre es segura.","¿Cuándo vuelve al suministro?",["En cuanto parezca limpia","Después del tratamiento y las comprobaciones","Cuando huela bien"],1,"Pruebas completadas: agua apta para el suministro. El procesador recupera su funcionamiento.","Los controles de calidad comprueban cosas que no podemos ver a simple vista."),
 task("restore_crops",3,"crops","irrigation","Revisa el riego después de la reparación","botanist","El circuito de agua ya funciona. Vamos a confirmar el riego y registrar cómo están las plantas.","¿Qué revisamos?",["Riego, humedad y estado de las hojas","Solo el tamaño de la maceta","Nada, las plantas se cuidan solas"],0,"Riego comprobado. Los cambios quedaron registrados para comparar mañana.","Después de modificar un sistema también revisamos los equipos que dependen de él."),
 task("exercise_force",3,"gym","exercise","Completa la sesión de resistencia","doctor","Esta máquina ofrece resistencia aunque pesemos menos. Practiquemos movimientos controlados siguiendo el plan del equipo médico.","¿Qué opción trabaja con seguridad?",["Movimiento controlado y carga indicada","La carga máxima sin preparación","Solo mirar cómo entrena otro"],0,"Bloque de resistencia completado mediante una práctica breve. Músculos y huesos necesitan actividad regular.","Menos gravedad cambia las cargas sobre el cuerpo. Las máquinas de resistencia ayudan a entrenar."),
 task("exercise_cardio",3,"gym","exercise","Completa la sesión cardiovascular","doctor","Ahora usamos la bicicleta y observamos cómo responde el cuerpo. En el juego resumimos una sesión más larga.","¿Qué hacemos si alguien se siente mal?",["Seguir sin decir nada","Detenerse y avisar al médico","Competir para terminar primero"],1,"Sesión registrada. Ahora descansaremos antes de preparar la salida científica.","El ejercicio debe adaptarse a cada persona. Comunicar molestias ayuda a cuidar al equipo."),
 task("eva3",3,"airlock","lock","Prepara la segunda salida","engineer","Traje revisado, enlace comprobado y ruta registrada. Repetimos la preparación de presión aunque ayer haya salido bien.","¿Por qué repetimos la lista?",["Porque las condiciones pueden cambiar","Porque olvidamos todo","Para perder tiempo"],0,"Salida autorizada. El geólogo te acompaña al punto de observación.","Una comprobación anterior no garantiza el estado actual de los equipos."),
 task("survey3",3,"exterior","rock","Registra el punto de observación","geologist","Esta textura es distinta de la muestra de ayer. Registremos el lugar antes de compararlas.","¿Cómo hacemos una comparación útil?",["Registrar ambas muestras con el mismo cuidado","Mezclarlas sin etiquetas","Elegir la más brillante"],0,"Registro guardado… Control de Misión está enviando un aviso urgente de clima espacial.","Comparar requiere registros fiables. La ciencia puede esperar si aparece un riesgo."),
 task("solar_choice",3,"exterior","rock","Decide y comienza el retorno","control","Tenemos una alerta de partículas solares. Regresen a la base y al refugio; las muestras son secundarias.","¿Cómo priorizas el regreso?",["Dejar las muestras y volver ahora","Recoger la bolsa: consume 30 s del reloj"],-1,"Decisión registrada. Sigue el indicador hacia la esclusa.","La radiación no se ve ni se oye. Seguimos los avisos y ponemos a las personas primero."),
 task("solar_lock",3,"airlock","lock","Entra por la esclusa de emergencia","engineer","Aplicaremos el procedimiento de retorno de emergencia. Acortamos la limpieza profunda, pero mantenemos el control de presión y las puertas interbloqueadas.","¿Qué paso sigue siendo obligatorio?",["Comprobar presión y abrir una puerta a la vez","Abrir todo para ganar tiempo","Entrar sin cerrar la puerta exterior"],0,"Presión comprobada. La limpieza detallada quedará para después: ahora al refugio.","La urgencia cambia prioridades, pero no permite perder el aire del hábitat."),
 task("shelter_all",3,"shelter","shield","Reúne a toda la tripulación","commander","El ingeniero, la bióloga, el médico y el geólogo están llegando. Pasemos lista y confirmemos el cierre del refugio.","¿Qué comprobamos antes de declarar al equipo protegido?",["Que estén las cinco personas y la puerta cerrada","Solo que haya comida","Solo que la comandante esté dentro"],0,"Cinco personas confirmadas. El equipo está reunido y la fase de retorno ha terminado.","Proteger al equipo significa comprobar que nadie quede atrás."),
 task("dose_check",3,"shelter","shield","Consulta el dosímetro del refugio","doctor","La lectura nos ayuda a registrar la exposición. El refugio la reduce, pero no hace desaparecer toda la radiación.","¿Qué hace un dosímetro?",["Bloquea todas las partículas","Mide radiación recibida","Predice exactamente todas las tormentas"],1,"Lectura registrada y enviada. Permaneceremos aquí hasta recibir instrucciones.","Medir y proteger son funciones distintas. Necesitamos ambas."),
 task("wait_control",3,"shelter","shield","Coordina la espera con Control","control","Seguimos evaluando el evento. Mantengan comunicación y cuidados del equipo mientras esperan.","¿Cuándo reanudamos las actividades?",["Cuando Control confirme que podemos hacerlo","Cuando termine una canción","Cuando alguien se aburra"],0,"Horas después… Control autoriza salir del refugio y revisar la base. El salto de tiempo resume la espera real.","La duración de una tormenta no la decide un cronómetro de juego. Se evalúan mediciones y condiciones."),
 task("final_health",3,"medical","vitals","Revisa al equipo después de la alerta","doctor","Revisamos cómo se siente cada persona y sus registros. No hay una medicina mágica que sustituya al refugio.","¿Qué ayuda ahora?",["Seguimiento médico y registro de exposición","Olvidar el incidente","Elegir medicamentos sin indicación"],0,"Revisión registrada. Todo el equipo participará en el informe final.","Los datos y el seguimiento ayudan a tomar decisiones médicas y mejorar los procedimientos."),
 task("final_report",3,"command","command","Completa el informe del día 3","commander","Cuidamos el agua, entrenamos y respondimos a una alerta. Dirigir también significa revisar qué podríamos mejorar.","¿Qué mensaje enviamos a futuras expediciones?",["Personas primero; medir, decidir y comprobar","Nunca hay que pedir ayuda","Solo importan las muestras"],0,"¡Primeros tres días completados! Puedes recorrer la base y consultar todos los sistemas.","La exploración necesita ciencia, cuidado y cooperación. Un rescate también nos deja aprendizajes.")
 ]

static func resolved_task(index: int, priority: String) -> Dictionary:
 var list := tasks()
 if index >= list.size(): return {}
 var t: Dictionary = list[index].duplicate(true)
 if t.id == "prepare" and priority == "lab":
  t.room = "minerals"
  t.target = "analyzer"
  t.speaker = "geologist"
  t.intro = "¡El analizador necesita una referencia, como una regla necesita marcas! Preparé una muestra de composición conocida."
  t.question = "¿Qué usamos para comprobar el instrumento?"
  t.choices = ["Una roca elegida al azar","Una muestra de referencia conocida","Una etiqueta sin muestra"]
 return t
